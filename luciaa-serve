#!/usr/bin/env bash
# luciaa-serve — watchdog that keeps 9router alive on Android/Termux
# why: Android freezes/kills Termux processes seconds after you leave the app
#      (and the dashboard's memory spike can trip the OOM killer).
#      This revives the router automatically, forever.
#
#   luciaa-serve start            → guard the router in the foreground
#   luciaa-serve start --daemon   → guard it detached (survives app switch)
#   luciaa-serve status           → is the router up? is the guard awake? key state?
#   luciaa-serve key              → key status (masked, never printed in full)
#   luciaa-serve key --auto       → re-fetch the key from the local router
#   luciaa-serve key --manual     → paste a key by hand, validated before writing
#   luciaa-serve repair           → fix a half-installed 9router (reinstall)
#   luciaa-serve logs             → tail the router log
#   luciaa-serve stop             → stop guard + router
#   luciaa-serve restart          → bounce both
#
# The watchdog also self-heals the api key on a timer: if opencode.json still
# holds the placeholder, or the stored key starts getting 401s (revoked/rotated),
# it re-fetches from the router and rewrites the config. No user action needed
# after the first key ever lands.
#
# PORTABLE: the installer rewrites the shebang to $PREFIX/bin/bash on Termux.
#           Works unchanged on Linux / macOS / WSL / VPS.

set -uo pipefail

PORT="${LUCIA_ROUTER_PORT:-20128}"
URL="http://127.0.0.1:$PORT/v1/models"
LOG="${LUCIA_ROUTER_LOG:-$HOME/.9router/serve.log}"
PIDFILE="${LUCIA_ROUTER_PIDFILE:-$HOME/.9router/serve.pid}"
CHECK_INTERVAL="${LUCIA_WATCHDOG_INTERVAL:-10}"
MAX_LOG_BYTES="${LUCIA_LOG_MAX_BYTES:-2097152}"
CONFIG="${LUCIA_CONFIG:-$HOME/.config/opencode/opencode.json}"
# how many watchdog loops between key re-checks (12 * 10s = ~2min)
KEY_RECONCILE_EVERY="${LUCIA_KEY_RECONCILE_EVERY:-12}"
# pattern used to clear a wedged router before reviving it; override if your
# process name differs and you don't want unrelated matches killed.
ROUTER_MATCH="${LUCIA_ROUTER_MATCH:-9router}"
PREFIX="${PREFIX:-}"

# ─── cross-OS 9router launcher ─────────────────────────────────
# Termux has no /usr/bin/env, so a bare `9router` dies with
# "bad interpreter". Linux/VPS/macOS are fine. Resolve once, reuse.
R9_BIN=""
resolve_r9() {
  [ -n "$R9_BIN" ] && return 0
  if command -v 9router >/dev/null 2>&1 && 9router --version >/dev/null 2>&1; then
    R9_BIN="9router"; return 0
  fi
  local c
  for c in "$PREFIX/lib/node_modules/9router/cli.js" \
           "$HOME/.npm-global/lib/node_modules/9router/cli.js" \
           "$HOME/.local/lib/node_modules/9router/cli.js" \
           "$HOME/.npm/lib/node_modules/9router/cli.js" \
           "/usr/local/lib/node_modules/9router/cli.js" \
           "/usr/lib/node_modules/9router/cli.js"; do
    [ -f "$c" ] && { R9_BIN="node $c"; return 0; }
  done
  if command -v npx >/dev/null 2>&1; then R9_BIN="npx -y 9router"; return 0; fi
  R9_BIN="9router"
}

# liveness: any HTTP response (200/401/…) means the server is listening;
# only a connection failure returns non-zero.
alive() { curl -s -m 5 -o /dev/null "$URL" 2>/dev/null; }

wait_ready() {
  local tries="${1:-20}" i=0
  while [ "$i" -lt "$tries" ]; do
    alive && return 0
    i=$((i+1)); sleep 1
  done
  return 1
}

heal_shebang() {
  [ -d "/data/data/com.termux" ] || [ "${LUCIA_FORCE_TERMUX:-}" = "1" ] || return 0
  [ -n "$PREFIX" ] || return 0
  local c
  for c in "$PREFIX/lib/node_modules/9router/cli.js" "$HOME/.local/lib/node_modules/9router/cli.js"; do
    [ -f "$c" ] || continue
    head -1 "$c" 2>/dev/null | grep -q '^#!/usr/bin/env' || continue
    sed -i "1s|#!/usr/bin/env node|#!$PREFIX/bin/env node|" "$c" 2>/dev/null
  done
}

# ─── api key ───────────────────────────────────────────────────
# 9router issues keys from its own dashboard and can rotate or revoke
# them independently of our config. Three ways the stored key goes bad:
#   1. the installer never got one (placeholder YOUR_9ROUTER_KEY_HERE)
#   2. first-run dashboard password was never set, so auto-fetch got nothing
#   3. the key was later revoked/rotated out from under us
# All three are recoverable without touching the user, so this runs from the
# watchdog loop. Nothing here ever prints the key itself, only a masked form.

cfg_base() {  # baseURL from config, scheme+host+port only (strip /v1)
  [ -f "$CONFIG" ] || { printf 'http://127.0.0.1:%s' "$PORT"; return; }
  tr -d '\n' < "$CONFIG" 2>/dev/null \
    | grep -o '"baseURL"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
    | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/' \
    | sed -E 's|/v1/?$||' \
    | grep -E '^https?://' || printf 'http://127.0.0.1:%s' "$PORT"
}

read_key() {  # current apiKey value as stored (empty if absent)
  [ -f "$CONFIG" ] || return 1
  tr -d '\n' < "$CONFIG" 2>/dev/null \
    | grep -o '"apiKey"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
    | sed -E 's/.*:[[:space:]]*"([^"]*)".*/\1/'
}

key_is_placeholder() {
  local k; k=$(read_key)
  [ -z "$k" ] || [ "${k#YOUR_9ROUTER}" != "$k" ]
}

# the router's own CLI token: sha256(machine-id + "9r-cli-auth" + secret)
router_keys_json() {
  local mid sec tok
  mid=$(cat "$HOME/.9router/machine-id" 2>/dev/null || true)
  sec=$(cat "$HOME/.9router/auth/cli-secret" 2>/dev/null || true)
  if [ -z "$mid" ] || [ -z "$sec" ]; then return 1; fi
  tok=$(printf '%s9r-cli-auth%s' "$mid" "$sec" | sha256sum | cut -c1-16)
  curl -s -m 5 -H "x-9r-cli-token: $tok" "http://127.0.0.1:$PORT/api/keys" 2>/dev/null
}

fetch_local_key() {
  router_keys_json 2>/dev/null | grep -o '"key":"[^"]*"' | head -1 | cut -d'"' -f4
}

# 0 = accepted, 2 = explicitly rejected, 1 = cannot tell (router down)
# Prefer the router's own key list as ground truth; /v1/models happily returns
# 200 without auth on a fresh router, so it can only prove a *negative*.
verify_key() {
  local k="$1" base="${2:-}" body code
  [ -n "$k" ] || return 1
  [ -n "$base" ] || base=$(cfg_base)
  body=$(router_keys_json 2>/dev/null)
  if [ -n "$body" ] && printf '%s' "$body" | grep -q '"key"'; then
    printf '%s' "$body" | grep -qF -- "$k" && return 0 || return 2
  fi
  code=$(curl -s -m 8 -o /dev/null -w '%{http_code}' \
    -H "Authorization: Bearer $k" "$base/v1/models" 2>/dev/null)
  case "$code" in
    401|403) return 2 ;;
    000|'')  return 1 ;;
    *)       return 0 ;;
  esac
}

# replace whatever is in the apiKey field, placeholder or stale value alike.
# the char whitelist is a sed-injection guard: '&' and '/' are special in the
# replacement, so refuse anything that isn't a plain key token.
write_key() {
  local k="$1"
  [ -f "$CONFIG" ] || return 1
  case "$k" in
    ""|*[!A-Za-z0-9._-]*) return 2 ;;
  esac
  grep -q '"apiKey"' "$CONFIG" 2>/dev/null || return 1
  sed -i -E 's|("apiKey"[[:space:]]*:[[:space:]]*")[^"]*(")|\1'"$k"'\2|' "$CONFIG" 2>/dev/null || return 1
  chmod 600 "$CONFIG" 2>/dev/null
  [ "$(read_key)" = "$k" ]
}

KEY_STATE="unknown"
reconcile_key() {
  [ -f "$CONFIG" ] || return 1
  local cur rc got
  cur=$(read_key)
  if [ -n "$cur" ] && [ "${cur#YOUR_9ROUTER}" = "$cur" ]; then
    verify_key "$cur"; rc=$?
    case "$rc" in
      0) KEY_STATE="ok"; return 0 ;;
      1) KEY_STATE="unknown"; return 0 ;;   # router down — key may be fine
      2) KEY_STATE="stale" ;;
    esac
  else
    KEY_STATE="placeholder"
  fi

  got=$(fetch_local_key 2>/dev/null)
  if [ -n "$got" ] && write_key "$got"; then
    KEY_STATE="ok"
    printf '%s api key %s from local 9router\n' "$(date '+%H:%M:%S')" "$KEY_STATE" >>"$LOG"
    return 0
  fi
  return 1
}

start_router() {
  resolve_r9
  mkdir -p "$(dirname "$LOG")" 2>/dev/null
  # shellcheck disable=SC2086
  if command -v setsid >/dev/null 2>&1; then
    setsid $R9_BIN --no-browser --skip-update >>"$LOG" 2>&1 < /dev/null &
  else
    nohup $R9_BIN --no-browser --skip-update >>"$LOG" 2>&1 < /dev/null &
  fi
  disown 2>/dev/null || true
}

notify() {
  command -v termux-notification >/dev/null 2>&1 && \
    termux-notification --title "luciaa" --content "$1" >/dev/null 2>&1
}

# repair a half-installed 9router: dangling shims and node_modules/9router
# trees with no cli.js (npm interrupted mid-install).
npm_repair() {
  local p d pdir cand pathdirs=()
  # catch dangling `9router` shims (not listed by `type -a`)
  IFS=':' read -ra pathdirs <<< "$PATH"
  for pdir in "${pathdirs[@]}"; do
    [ -n "$pdir" ] || continue
    cand="$pdir/9router"
    [ -L "$cand" ] && [ ! -e "$cand" ] && [ -w "$pdir" ] && rm -f "$cand" 2>/dev/null
  done
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ -e "$p" ] || rm -f "$p" 2>/dev/null
  done < <(type -a 9router 2>/dev/null | sed -n 's/^9router is //p')
  for d in "$PREFIX/lib/node_modules/9router" \
           "$HOME/.npm-global/lib/node_modules/9router" \
           "$HOME/.local/lib/node_modules/9router" \
           "$HOME/.npm/lib/node_modules/9router"; do
    [ -d "$d" ] && [ ! -f "$d/cli.js" ] && [ -w "$d" ] && rm -rf "$d" 2>/dev/null
  done
  command -v npm >/dev/null 2>&1 || return 1
  npm i -g 9router@latest --prefer-online >/dev/null 2>&1
}

cmd_repair() {
  echo "repairing 9router install…"
  heal_shebang
  if npm_repair; then echo "npm reinstall done"; else echo "npm unavailable — install Node.js/npm first"; fi
  R9_BIN=""; resolve_r9
  if $R9_BIN --version >/dev/null 2>&1; then
    echo "9router OK: $R9_BIN"
  else
    echo "9router still broken — check: npm i -g 9router"
    return 1
  fi
}

rotate_log() {
  [ -f "$LOG" ] || return 0
  local size
  size=$(wc -c <"$LOG" 2>/dev/null | tr -d ' ')
  [ -n "$size" ] && [ "$size" -gt "$MAX_LOG_BYTES" ] 2>/dev/null && {
    tail -c 262144 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" 2>/dev/null
  }
}

guard_pid() {
  [ -f "$PIDFILE" ] || return 1
  local pid; pid=$(cat "$PIDFILE" 2>/dev/null || true)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# the actual monitor loop (foreground; `--daemon` re-execs into this)
monitor() {
  heal_shebang
  resolve_r9

  if ! alive; then
    start_router
    wait_ready 20 && echo "router started on :$PORT" || echo "router booting slowly — watchdog will keep reviving it"
  else
    echo "router already up on :$PORT — watchdog will guard it"
  fi

  if command -v termux-wake-lock >/dev/null 2>&1; then
    termux-wake-lock 2>/dev/null && echo "wake lock held (CPU won't sleep)"
  fi

  # key reconcile, now that the router is (probably) listening. safe to run
  # before it's up: verify_key reports "cannot tell" and we leave the key be.
  if reconcile_key; then
    echo "api key: ok ($KEY_STATE)"
  else
    echo "api key: UNRESOLVED ($KEY_STATE) — every model call will 401"
    echo "         luciaa-serve key --manual   # paste one from the 9router Keys page"
    notify "luciaa: 9router api key missing"
  fi

  echo "$$" > "$PIDFILE"
  trap 'rm -f "$PIDFILE"; exit 0' INT TERM HUP
  notify "9router watchdog active"
  echo "watchdog awake (pid $$) — checks every ${CHECK_INTERVAL}s, revives if dead. log: $LOG"

  local restarts=0 backoff=1 fails=0 repaired=false keywarned=false keyloops=0
  while true; do
    sleep "$CHECK_INTERVAL"
    rotate_log

    # periodic key re-check: catches a key revoked or rotated after install
    keyloops=$((keyloops + 1))
    if [ "$keyloops" -ge "$KEY_RECONCILE_EVERY" ]; then
      keyloops=0
      if ! reconcile_key; then
        [ "$keywarned" = false ] && {
          printf '%s api key unresolved (%s)\n' "$(date '+%H:%M:%S')" "$KEY_STATE" >>"$LOG"
          notify "luciaa: 9router api key unresolved"
          keywarned=true
        }
      else
        [ "$keywarned" = true ] && {
          printf '%s api key recovered\n' "$(date '+%H:%M:%S')" >>"$LOG"
          keywarned=false
        }
      fi
    fi

    if ! alive; then
      restarts=$((restarts+1))
      echo "$(date '+%H:%M:%S') router down — reviving (#$restarts)" >>"$LOG"
      pkill -f "$ROUTER_MATCH" 2>/dev/null
      sleep 1
      start_router
      if wait_ready 15; then
        echo "$(date '+%H:%M:%S') revived (#$restarts)" >>"$LOG"
        notify "9router revived (#$restarts)"
        restarts=0; backoff=1; fails=0
      else
        fails=$((fails+1))
        if [ "$fails" -ge 3 ] && [ "$repaired" = false ]; then
          echo "$(date '+%H:%M:%S') 3 failed revives — repairing 9router install" >>"$LOG"
          notify "repairing 9router install…"
          heal_shebang
          if npm_repair; then R9_BIN=""; resolve_r9; fi
          repaired=true
        fi
        backoff=$((backoff*2)); [ "$backoff" -gt 60 ] && backoff=60
        echo "$(date '+%H:%M:%S') revive failed — backing off ${backoff}s" >>"$LOG"
        sleep "$backoff"
      fi
    fi
  done
}

cmd_key() {
  local mode="${1:-status}" cur rc base
  base=$(cfg_base)
  case "$mode" in
    --manual|-m)
      printf 'router : %s\n' "$base"
      if [ -t 0 ]; then
        printf 'open that in a browser, dashboard -> Keys, copy an sk-... key\n'
        read -rs -p 'paste key (blank to abort): ' cur; echo
      else
        # piped/redirected:  printf '%s' sk-... | luciaa-serve key --manual
        printf 'reading key from stdin (blank to abort): '
        IFS= read -r cur || cur=""
      fi
      [ -z "$cur" ] && { echo "aborted — nothing written"; return 1; }
      verify_key "$cur" "$base"; rc=$?
      if [ "$rc" -eq 2 ]; then
        echo "router REJECTED that key (401/403) — nothing written"
        return 1
      fi
      [ "$rc" -eq 1 ] && echo "! router unreachable — writing unverified, re-check with: luciaa-serve key"
      write_key "$cur" && echo "key written to $CONFIG" || { echo "write failed (bad chars, or no apiKey field)"; return 1; }
      ;;
    --auto)
      if reconcile_key; then
        echo "key ok ($KEY_STATE) in $CONFIG"
      else
        echo "could not auto-resolve a key ($KEY_STATE)"
        echo "  the router has not issued one, or the dashboard password was never set"
        echo "  fix: open $base -> set password -> Keys -> then: luciaa-serve key --manual"
        return 1
      fi
      ;;
    status|*)
      cur=$(read_key)
      case "$cur" in
        "") echo "key    : MISSING — no apiKey field in config" ;;
        YOUR_9ROUTER*)
          echo "key    : PLACEHOLDER — installer never got one"
          echo "fix    : luciaa-serve key --manual" ;;
        *)
          verify_key "$cur" "$base"; rc=$?
          echo "key    : ${cur:0:8}…${cur: -4}"
          case "$rc" in
            0) echo "status : ACCEPTED by router" ;;
            2) echo "status : REJECTED (401/403) — revoked or rotated"
               echo "fix    : luciaa-serve key --auto   # re-fetch, or --manual to paste" ;;
            *) echo "status : router unreachable — cannot verify right now" ;;
          esac ;;
      esac
      echo "config : $CONFIG"
      echo "router : $base"
      [ "$mode" != "status" ] && [ "$mode" != "" ] && {
        echo "usage: luciaa-serve key [status|--auto|--manual]"; return 1; }
      ;;
  esac
}

cmd_start() {
  local daemon=false
  [ "${1:-}" = "--daemon" ] || [ "${1:-}" = "-d" ] && daemon=true

  mkdir -p "$(dirname "$LOG")" 2>/dev/null
  if guard_pid; then
    echo "watchdog already running (pid $(cat "$PIDFILE"))"
    return 0
  fi
  [ -f "$PIDFILE" ] && rm -f "$PIDFILE" 2>/dev/null

  if [ "$daemon" = true ]; then
    echo "starting watchdog (detached)…"
    if command -v setsid >/dev/null 2>&1; then
      setsid bash "$0" __monitor >>"$LOG" 2>&1 < /dev/null &
    else
      nohup bash "$0" __monitor >>"$LOG" 2>&1 < /dev/null &
    fi
    disown 2>/dev/null || true
    sleep 2
    cmd_status
    return 0
  fi
  monitor
}

cmd_status() {
  if alive; then echo "router  : UP on :$PORT"; else echo "router  : DOWN"; fi
  local cur
  cur=$(read_key)
  case "$cur" in
    "")                 echo "key     : MISSING — luciaa-serve key --manual" ;;
    YOUR_9ROUTER_KEY*)  echo "key     : PLACEHOLDER — luciaa-serve key --manual" ;;
    *) echo "key     : ${cur:0:8}…${cur: -4}" ;;
  esac
  if guard_pid; then
    echo "watchdog: running (pid $(cat "$PIDFILE"))"
  else
    echo "watchdog: not running — start it with: luciaa-serve start"
  fi
  [ -f "$LOG" ] && { echo "recent events:"; tail -5 "$LOG" 2>/dev/null | sed 's/^/    /'; }
}

cmd_stop() {
  if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null && echo "watchdog stopped"
    rm -f "$PIDFILE" 2>/dev/null
  else
    echo "watchdog was not running"
  fi
  pkill -f "$ROUTER_MATCH" 2>/dev/null
  command -v termux-wake-unlock >/dev/null 2>&1 && termux-wake-unlock 2>/dev/null
  echo "router stopped"
}

case "${1:-start}" in
  start)     shift || true; cmd_start "${1:-}" ;;
  __monitor) monitor ;;
  status)    cmd_status ;;
  logs)      [ -f "$LOG" ] && tail -n "${2:-40}" "$LOG" || echo "no log yet at $LOG" ;;
  repair)    cmd_repair ;;
  key)       cmd_key "${2:-status}" ;;
  stop)      cmd_stop ;;
  restart)   cmd_stop; sleep 1; cmd_start "--daemon" ;;
  *)         echo "usage: luciaa-serve [start [--daemon]|status|logs|repair|key [status|--auto|--manual]|stop|restart]" ;;
esac
