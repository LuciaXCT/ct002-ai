#!/bin/bash
# ct002-chat — opencode with the deck always one /arena away
#
# boots opencode inside its own private tmux session, so $TMUX is set
# and /arena's floating-deck popup works EVERY time — zero tmux knowledge.
#   ct002            ← start CT-002 (this)
#   ct002-chat       ← same thing, long name
#
# already inside tmux, or tmux missing? plain opencode, /arena falls back
# to the compact card. nothing breaks either way.

have() { command -v "$1" >/dev/null 2>&1; }

# already inside tmux → just launch opencode, popup works natively
if [ -n "${TMUX:-}" ]; then
  exec opencode "$@"
fi

# no tmux binary → plain opencode (card fallback for /arena)
if ! have tmux; then
  exec opencode "$@"
fi

# private session named after the tty — parallel windows never collide
SESSION="ct002-$(tty | sed 's|/dev/||; s|/|-|g')"

# kill a stale session from a dead tty with the same name
tmux has-session -t "$SESSION" 2>/dev/null && tmux kill-session -t "$SESSION"

# auto-detach other clients, create, attach — one command, feels native
exec tmux new-session -A -s "$SESSION" opencode "$@"
