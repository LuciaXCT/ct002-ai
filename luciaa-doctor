#!/usr/bin/env node
// luciaa-doctor — probe every model in your opencode config, show what's alive
// run:  luciaa-doctor          → health table
//       luciaa-doctor --fix    → also switch default to a live model if the current one is dead

import fs from 'node:fs';
import os from 'node:os';

import path from 'node:path';

const HOME = os.homedir();
const CANDIDATES = [
  HOME + '/.config/opencode/opencode.json',
  HOME + '/.config/opencode/opencode.jsonc',
];

function loadConfig() {
  for (const p of CANDIDATES) {
    if (!fs.existsSync(p)) continue;
    let raw = fs.readFileSync(p, 'utf8');
    // jsonc: strip comments + trailing commas so we can JSON.parse it
    raw = raw.replace(/\/\*[\s\S]*?\*\//g, '').replace(/^[ \t]*\/\/.*$/gm, '');
    raw = raw.replace(/,(\s*[}\]])/g, '$1');
    try {
      return { cfg: JSON.parse(raw), file: p };
    } catch {}
  }
  return { cfg: null, file: CANDIDATES[0] };
}

const { cfg, file: CFG } = loadConfig();
if (!cfg) {
  console.log('✗ no readable config at ' + CFG + ' — run the luciaa-ai installer first');
  process.exit(1);
}

// Legacy filenames opencode still reads — a flat provider entry in one of these
// (baseURL/apiKey at the provider top level) fails validation for the entire
// config, which surfaces as "Unrecognized keys" or as invalid-credential errors.
const LEGACY = [
  HOME + '/.config/opencode/config.json',
  HOME + '/.config/opencode/opencode.jsonc',
];
const legacyShadows = LEGACY.filter((p) => fs.existsSync(p) && !p.startsWith(CFG));
if (legacyShadows.length) {
  console.log('  ! legacy config present: ' + legacyShadows.join(', '));
  console.log('    opencode reads it too — retire it if providers misbehave:');
  console.log('    mv <file> <file>.retired');
}

const prov = cfg.provider?.luciaa;
if (!prov) {
  console.log('✗ no luciaa provider in config — run the installer');
  process.exit(1);
}
const base = (prov.options?.baseURL || '').replace(/\/v1\/?$/, '');
const key = prov.options?.apiKey || '';

// ─── repo-shadow + placeholder guard (the #1 invalid-key cause) ──
// opencode merges ./opencode.json when you run INSIDE ~/luciaa-ai.
// That repo file always holds YOUR_9ROUTER_KEY_HERE by design (never commit keys).
// Fingers cold on the screen, eyes blurry — you cd wrong and boom, invalid key.
try {
  const cwdCfg = process.cwd() + '/opencode.json';
  if (cwdCfg !== CFG && fs.existsSync(cwdCfg)) {
    const raw = fs.readFileSync(cwdCfg, 'utf8');
    if (raw.includes('YOUR_9ROUTER_KEY_HERE')) {
      console.log('  ! CWD SHADOW: ./opencode.json in ' + process.cwd() + ' has placeholder key');
      console.log('    opencode is reading THIS file, not ' + CFG);
      console.log('    fix: cd ~ && opencode   (repo json never holds keys by design)');
      console.log('');
    }
  }
} catch {}
if (!key || key.includes('YOUR_9ROUTER_KEY_HERE')) {
  // _i think: no point probing, every model will scream 401_
  console.log('✗ apiKey is still placeholder in ' + CFG);
  console.log('  fix 1: cd ~ && opencode  (are you inside ~/luciaa-ai right now?)');
  console.log('  fix 2: paste real sk-... from 9router Keys page into provider.luciaa.options.apiKey');
  console.log('  fix 3: auto-fetch local key → curl -s -H "x-9r-cli-token: $(printf ...)" http://localhost:20128/api/keys');
  process.exit(1);
}
const models = Object.keys(prov.models || {});
if (!models.length) {
  console.log('✗ no models listed in config');
  process.exit(1);
}

async function probe(model) {
  const t0 = Date.now();
  try {
    const r = await fetch(base + '/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + key },
      body: JSON.stringify({ model, messages: [{ role: 'user', content: 'ping' }], max_tokens: 1 }),
      signal: AbortSignal.timeout(20000),
    });
    const ms = Date.now() - t0;
    const body = await r.json().catch(() => ({}));
    const msg = (body && body.error && body.error.message) || '';
    if (r.ok) return { model, ok: true, ms, tag: 'ALIVE', note: '' };
    if (r.status === 401 || r.status === 403 || /credential|unauthor|invalid api key/i.test(msg)) {
      // A legacy config that fails validation can leave the provider without any
      // credentials at all, which looks exactly like a quota-demoted key.
      const note = legacyShadows.length
        ? 'invalid creds OR blocked by legacy config — retire ' +
          legacyShadows.map((p) => path.basename(p)).join(', ')
        : 'quota demoted — may revive later';
      return { model, ok: false, tag: 'DEAD CREDS', note };
    }
    if (r.status === 429) return { model, ok: true, ms, tag: 'RATE-LIMITED', note: 'alive, cooling down' };
    if (r.status >= 500) return { model, ok: false, tag: 'UPSTREAM DOWN', note: msg.slice(0, 60) };
    return { model, ok: false, tag: 'ERR ' + r.status, note: msg.slice(0, 60) };
  } catch (e) {
    return { model, ok: false, tag: 'TIMEOUT', note: String(e).slice(0, 40) };
  }
}

const current = (cfg.agent?.luciaa?.model || '').replace(/^luciaa\//, '');
const width = Math.max(...models.map((m) => m.length)) + 2;

console.log('\n  luciaa-doctor — probing ' + models.length + ' models on ' + base + ' …\n');
const results = await Promise.all(models.map(probe));

for (const r of results) {
  const cur = r.model === current ? '  ← current default' : '';
  const combo = /my9model|opencode-free|combo/i.test(r.model) ? '  [auto-rotate combo]' : '';
  const note = r.note ? '  · ' + r.note : '';
  console.log('  ' + (r.ok ? '✓' : '✗') + ' ' + r.model.padEnd(width) + r.tag + combo + cur + note);
}

const aliveSorted = results.filter((r) => r.ok && r.ms).sort((a, b) => a.ms - b.ms);
if (aliveSorted.length) {
  console.log('\n  fastest alive: ' + aliveSorted[0].model + ' (' + aliveSorted[0].ms + 'ms)');
}
const aliveIds = results.filter((r) => r.ok).map((r) => r.model);
const currentResult = results.find((r) => r.model === current);

if (process.argv.includes('--fix')) {
  if (currentResult && currentResult.ok) {
    console.log('  default is alive — nothing to fix');
  } else if (aliveIds.length) {
    cfg.agent.luciaa.model = 'luciaa/' + aliveIds[0];
    if (cfg.model !== undefined) cfg.model = 'luciaa/' + aliveIds[0];
    fs.writeFileSync(CFG, JSON.stringify(cfg, null, 2));
    console.log('  fixed: default → luciaa/' + aliveIds[0] + ' — restart opencode');
  } else {
    console.log('  nothing alive — is the router up? run: 9router');
  }
} else if (currentResult && !currentResult.ok && aliveIds.length) {
  console.log('  default is DEAD — rerun with --fix to heal it');
}

const combosAlive = results.filter((r) => r.ok && /my9model|opencode-free|combo/i.test(r.model));
if (combosAlive.length) {
  console.log('  auto-rotate: AVAILABLE — use a [combo] model as default (m in TUI, or --fix)');
} else {
  console.log('  auto-rotate: combos are credential-dead right now — they revive when quota resets');
}
console.log('');